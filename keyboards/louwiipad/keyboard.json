{
    "manufacturer": "Louwii",
    "keyboard_name": "Louwii Pad",
    "maintainer": "Louwii",
    "development_board": "promicro",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "encoder": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgblight": true
    },
    "matrix_pins": {
        "cols": ["B6", "C6", "C7", "F5"],
        "rows": ["D7", "B4"]
    },
    "url": "https://github.com/LouWii/louwii-pad",
    "bootloader_instructions": "Double press the button marked *sw1*",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0102",
        "vid": "0x0140"
    },
    "build": {
        "firmware_format": "hex"
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                {"label": "A", "matrix": [0, 0], "x": 0, "y": 0},
                {"label": "B", "matrix": [0, 1], "x": 1, "y": 0},
                {"label": "C", "matrix": [0, 2], "x": 2, "y": 0},
                {"label": "D", "matrix": [0, 3], "x": 3, "y": 0},
                {"label": "E", "matrix": [1, 0], "x": 0, "y": 1},
                {"label": "F", "matrix": [1, 1], "x": 1, "y": 1},
                {"label": "G", "matrix": [1, 2], "x": 2, "y": 1},
                {"label": "H", "matrix": [1, 3], "x": 3, "y": 1}
            ]
        }
    },
    "encoder": {
        "rotary": [
            {"pin_a": "D4", "pin_b": "D6"},
            {"pin_a": "D2", "pin_b": "D3"},
            {"pin_a": "B0", "pin_b": "B7"},
            {"pin_a": "F7", "pin_b": "F6"},
            {"pin_a": "F4", "pin_b": "F1"},
            {"pin_a": "F0", "pin_b": "E6"}
        ]
    },
    "rgblight": {
        "animations": {
            "breathing": true,
            "rainbow_mood": true,
            "alternating": true
        },
        "hue_steps": 4,
        "led_count": 4,
        "pin": "B5"
    },
    "ws2812": {
        "pin": "B5"
    }
}